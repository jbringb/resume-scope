# Copy to .env for docker compose. For local vLLM: SPRING_PROFILES_ACTIVE=local-vllm
OPENAI_API_KEY=change-me
# Must include /v1 (the official openai-java SDK behind Spring AI 2.0+ no longer appends it).
# App on host: http://localhost:8000/v1
# App in Docker, vLLM on host: http://host.docker.internal:8000/v1
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=Qwen/Qwen3-4B-Instruct-2507
